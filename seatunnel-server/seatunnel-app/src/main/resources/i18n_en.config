Jdbc {
    host = "Database Server Host"
    host_description = "The hostname or IP address of the database server."
    port = "Database Server Port"
    port_description = "The port of the database server, default 3306."
    server_time_zone = "Server Time Zone"
    server_time_zone_description = "The session time zone of the database server, e.g. Asia/Shanghai or UTC."
    url = "JDBC Url"
    url_description = "The URL of the JDBC connection. Refer to a case: jdbc:mysql://localhost:3306/test?enabledTLSProtocols=TLSv1.2&rewriteBatchedStatements=true"
    driver = "JDBC Driver"
    driver_description = "The JDBC driver class for the database. eg: com.mysql.cj.jdbc.Driver"
    user = "User"
    username = "Username"
    password = "Password"
    query = "Query"
    query_description = "The sql to read data from source"
    connection_check_timeout_sec = "Connection Check Timeout"
    connection_check_timeout_sec_description = "Timeout for connection check"
    partition_column = "Column For Split"
    partition_column_description = "The column can be used to split the data, It is recommended to use the self-increasing primary key in the table or the primary key of number type with sufficient hash"
    partition_upper_bound = "Max value of split column"
    partition_upper_bound_description = "The max value of the split column"
    partition_lower_bound = "Min value of split column"
    partition_lower_bound_description = "The min value of the split column"
    partition_num = "Split Number"
    partition_num_description = "How many split you want to use, default value is equals to parallelism"
    fetch_size = "Fetch Size"
    fetch_size_description = "You can change the number of rows retrieved with each trip to the database cursor by changing the row fetch size value"
    parallelism = "Parallelism"
    parallelism_description = "The parallel threads are used to read data. The default is 1"
    database = "Database"
    table = "Table"
    primary_keys = "Primary Keys"
    primary_keys_description = "The primary keys of the table"
    support_upsert_by_query_primary_key_exist = "Upsert by primary key"
    support_upsert_by_query_primary_key_exist_description = "Support upsert by query primary key if exist"
    max_retries = "Max Retries"
    batch_interval_ms = "Batch Interval"
    batch_interval_ms_description = "The maximum interval between two write batches, Unit is ms, default value is 1000"
    batch_size = "Batch Size"
    batch_size_description = "The maximum rows a batch"
    is_exactly_once = "Enable Exactly Once"
    is_exactly_once_description = "Enable XA transaction to ensure accurate data writing"
    xa_data_source_class_name = "XA class name"
    xa_data_source_class_name_description = "The XA class name for the database"
    max_commit_attempts = "Max Commit Attempts"
    max_commit_attempts_description = "If transaction commit failed, retry times"
    transaction_timeout_sec = "Timeout for transaction"
    transaction_timeout_sec_description = "Timeout for transaction, Unit is second"
    auto_commit = "Auto Commit"
    auto_commit_description = "Auto commit transaction"
    schema_save_mode = "Schema Save Mode"
    schema_save_mode_description = "Automatically create the table if it does not exist, handle existing tables based on strategy"
    data_save_mode = "Data Save Mode"
    data_save_mode_description = "Data persistence strategy when writing data"
    create_index = "Create Index"
    create_index_description = "Whether to automatically create indexes before writing"
    is_primary_key_updated = "Update Primary Key"
    is_primary_key_updated_description = "Whether to update existing data on primary key conflict"
    support_upsert_by_insert_only = "Upsert via Insert Only"
    support_upsert_by_insert_only_description = "Use INSERT-only statements to implement Upsert semantics"
    use_copy_statement = "Use Copy Statement"
    use_copy_statement_description = "Whether to use COPY statement for batch writes"
    compatible_mode = "Compatible Mode"
    compatible_mode_description = "Database compatibility mode, leave empty if no special compatibility needed"
    enable_upsert = "Enable Upsert"
    enable_upsert_description = "Whether to enable Upsert write mode"
    field_ide = "Field Naming Strategy"
    field_ide_description = "Field name transformation strategy"
    tablePrefix = "Table Prefix"
    tablePrefix_description = "Prefix for the target table name"
    tableSuffix = "Table Suffix"
    tableSuffix_description = "Suffix for the target table name"
    multi_table_sink_replica = "Multi-Table Sink Replica"
    multi_table_sink_replica_description = "Number of replicas for multi-table writes"
    dialect = "SQL Dialect"
    dialect_description = "Database SQL dialect, automatically selected based on database type"
    table_path = "Table Path"
    table_path_description = "The full path of the table"
    where_condition = "Where Condition"
    where_condition_description = "Row-level filter condition, must start with 'where', e.g. where id > 100"
    table_list = "Table List Config"
    table_list_description = "Detailed table list configuration for multi-table reading"
    split_size = "Split Size"
    split_size_description = "The split size (number of rows) of table snapshot, captured tables are split into multiple splits when read"
    split_even_distribution_factor_upper_bound = "Upper Bound of Split Distribution Factor"
    split_even_distribution_factor_upper_bound_description = "The upper bound of the split key distribution factor, used to determine if the table data is evenly distributed"
    split_even_distribution_factor_lower_bound = "Lower Bound of Split Distribution Factor"
    split_even_distribution_factor_lower_bound_description = "The lower bound of the split key distribution factor, used to determine if the table data is evenly distributed"
    split_sample_sharding_threshold = "Sample Sharding Threshold"
    split_sample_sharding_threshold_description = "The threshold of estimated shard count to trigger sample sharding, default is 1000 shards"
    split_inverse_sampling_rate = "Inverse Sampling Rate"
    split_inverse_sampling_rate_description = "The inverse of the sampling rate for the sample sharding strategy"
    use_select_count = "Use Select Count"
    use_select_count_description = "Whether to use SELECT COUNT for table row count estimation"
    skip_analyze = "Skip Analyze"
    skip_analyze_description = "Whether to skip the analysis of table row count"
    use_regex = "Use Regex"
    use_regex_description = "Whether to use regular expression for table path matching"
    split_string_split_mode = "String Split Mode"
    split_string_split_mode_description = "The splitting algorithm mode for string type partition columns"
    split_string_split_mode_collate = "String Split Collation"
    split_string_split_mode_collate_description = "Specifies the collation when string_split_mode is set to charset_based and the table has a special collation"
    properties = "Connection Properties"
    properties_description = "Additional JDBC connection configuration parameters"
    decimal_type_narrowing = "Decimal Type Narrowing"
    decimal_type_narrowing_description = "Whether to narrow decimal types to more specific Java numeric types"
    int_type_narrowing = "Integer Type Narrowing"
    int_type_narrowing_description = "Whether to narrow integer types (such as TINYINT(1)) to more specific boolean types"
    RECREATE_SCHEMA = "Drop and Recreate Table"
    CREATE_SCHEMA_WHEN_NOT_EXIST = "Create When Not Exist"
    ERROR_WHEN_SCHEMA_NOT_EXIST = "Error When Not Exist"
    IGNORE = "Ignore Target Schema"
    DROP_DATA = "Drop Data"
    APPEND_DATA = "Append Data"
    CUSTOM_PROCESSING = "Custom Processing"
    ERROR_WHEN_DATA_EXISTS = "Error When Data Exists"
    ORIGINAL = "Keep Original Names"
    UPPERCASE = "Convert to Uppercase"
    LOWERCASE = "Convert to Lowercase"
    SAMPLE = "Sample Splitting"
    CHARSET_BASED = "Charset-Based Splitting"
}

S3File {
    path = "Path"
    path_description = "The path in the s3 bucket. eg: /seatunnel/path1"
    file_format_type = "File FormatType"
