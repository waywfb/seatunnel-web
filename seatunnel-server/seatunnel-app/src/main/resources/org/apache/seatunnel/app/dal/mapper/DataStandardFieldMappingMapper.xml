<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apache.seatunnel.app.dal.mapper.DataStandardFieldMappingMapper">
  <insert id="insertBatchSomeColumn">
    insert into t_st_data_standard_field_mapping (id, version_id, field_id, source_name, source_index, mapping_type, sample_value, workspace_id, create_time)
    values
    <foreach collection="list" item="item" separator=",">
      (#{item.id},
      #{item.versionId},
      #{item.fieldId},
      #{item.sourceName},
      #{item.sourceIndex},
      #{item.mappingType},
      #{item.sampleValue},
      #{item.workspaceId},
      #{item.createTime})
    </foreach>
  </insert>
</mapper>
