<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apache.seatunnel.app.dal.mapper.JobInstanceMapper">
    <resultMap id="BaseResultMap" type="org.apache.seatunnel.app.dal.entity.JobInstance">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="job_define_id" jdbcType="BIGINT" property="jobDefineId"/>
        <result column="job_status" jdbcType="VARCHAR" property="jobStatus"/>
        <result column="job_config" jdbcType="VARCHAR" property="jobConfig"/>
        <result column="engine_name" jdbcType="VARCHAR" property="engineName"/>
        <result column="engine_version" jdbcType="VARCHAR" property="engineVersion"/>
        <result column="job_engine_id" jdbcType="VARCHAR" property="jobEngineId"/>
        <result column="error_message" jdbcType="VARCHAR" property="errorMessage"/>
        <result column="workspace_id" jdbcType="BIGINT" property="workspaceId"/>
    </resultMap>
    <sql id="Base_Column_List">
        id
        , `job_define_id`, `job_status`, `job_config`, `engine_name`, `engine_version`, `job_engine_id`,`error_message`, `workspace_id`
    </sql>

    <sql id="jobInstancePagingWhere">
        <where>
            ji.workspace_id = #{workspaceId}
            <if test="startTime != null">
                AND ji.create_time <![CDATA[ >=]]> #{startTime}
            </if>
            <if test="endTime == null">
                AND (ji.end_time is null or ji.end_time <![CDATA[ <=]]> #{endTime})
            </if>
            <if test="endTime != null">
                AND (ji.end_time <![CDATA[ <=]]> #{endTime} or ji.end_time is null)
            </if>
            <if test="jobDefineName != null">
                AND jd.name LIKE concat('%', #{jobDefineName}, '%')
            </if>
            <if test="executorName != null and executorName != ''">
                AND cu.username = #{executorName}
            </if>
            <if test="jobMode != null">
                AND ji.job_type = #{jobMode}
            </if>
        </where>
    </sql>
    <!--
      状态筛选：与状态计数同口径的三组状态映射，保证「状态角标计数」与「列表过滤结果」可对齐；
      其余状态（暂停/取消等）只计入“全部”，不受 stateType 分组影响。
      传入具体 JobStatus（如从历史路由 query 续接）时走 equality 兜底。
    -->
    <sql id="jobInstanceStateFilter">
        <if test="stateType != null and stateType != ''">
            <choose>
                <when test="stateType == 'RUNNING'">
                    AND ji.job_status IN ('RUNNING', 'SUBMITTED_SUCCESS')
                </when>
                <when test="stateType == 'SUCCESS'">
                    AND ji.job_status IN ('SUCCESS', 'FINISHED', 'FORCED_SUCCESS')
                </when>
                <when test="stateType == 'FAILED'">
                    AND ji.job_status IN ('FAILURE', 'FAILED')
                </when>
                <otherwise>
                    AND ji.job_status = #{stateType}
                </otherwise>
            </choose>
        </if>
    </sql>
    <select id="queryJobInstanceListPaging" resultType="org.apache.seatunnel.app.domain.dto.job.SeaTunnelJobInstanceDto">
        SELECT ji.*, jd.name AS jobDefineName, cu.username AS username
        FROM t_st_job_instance ji
        LEFT JOIN t_st_job_definition jd ON ji.job_define_id = jd.id
        LEFT JOIN `user` cu ON ji.create_user_id = cu.id
        <include refid="jobInstancePagingWhere"/>
        <include refid="jobInstanceStateFilter"/>
        ORDER BY ji.create_time DESC
    </select>
    <!--
      实例列表统计卡全局计数：与分页查询同 WHERE（同 workspace/时间/名称/执行用户/模式过滤），
      但**不含 stateType 状态筛选**，这样四个状态角标互相可比、切换状态时角标不跳变；
      在 SQL 层聚合，不受当前页与权限后置过滤影响；状态口径与前端状态角标一致：
      running=RUNNING/SUBMITTED_SUCCESS，success=SUCCESS/FINISHED/FORCED_SUCCESS，failed=FAILURE/FAILED
    -->
    <select id="countJobStatusStats" resultType="org.apache.seatunnel.app.domain.response.metrics.JobInstanceStatusStats">
        SELECT
            COUNT(*) AS totalCount,
            COALESCE(SUM(ji.job_status IN ('RUNNING', 'SUBMITTED_SUCCESS')), 0) AS runningCount,
            COALESCE(SUM(ji.job_status IN ('SUCCESS', 'FINISHED', 'FORCED_SUCCESS')), 0) AS successCount,
            COALESCE(SUM(ji.job_status IN ('FAILURE', 'FAILED')), 0) AS failedCount
        FROM t_st_job_instance ji
        LEFT JOIN t_st_job_definition jd ON ji.job_define_id = jd.id
        LEFT JOIN `user` cu ON ji.create_user_id = cu.id
        <include refid="jobInstancePagingWhere"/>
    </select>
    <!--
      未彻底结束的实例：排除 FINISHED/FAILED/CANCELED。
      保留可恢复终态（如 SAVEPOINT_DONE）和中间态，才能由 MonitorTaskScheduler
      检测到「引擎侧恢复运行」并把状态回写 DB；否则恢复后 DB 状态永远停留在暂停态。
    -->
    <select id="getAllUnfinishedJobInstance" resultType="org.apache.seatunnel.app.dal.entity.JobInstance">
        SELECT <include refid="Base_Column_List"/>
        FROM t_st_job_instance t
        WHERE t.job_status IS NULL
           OR t.job_status NOT IN ('FINISHED', 'FAILED', 'CANCELED')
    </select>
    <!--
      与 getAllUnfinishedJobInstance 的排除集合保持一致，避免覆盖用户主动停止的终态。
      errorMessage 非 null 时一并回写 error_message：引擎返回 UNKNOWABLE 时写入“状态丢失”标记，
      从 UNKNOWABLE 迁出（如重新拉起后引擎恢复运行）时传空串清空，其余场景传 null 不触碰该列。
    -->
    <update id="updateStatusIfNotEndState">
        UPDATE t_st_job_instance
        SET job_status = #{jobStatus},
            end_time   = #{endTime,jdbcType=TIMESTAMP}
        <if test="errorMessage != null">
            , error_message = #{errorMessage}
        </if>
        WHERE id = #{id}
          AND (job_status IS NULL OR job_status NOT IN ('FINISHED', 'FAILED', 'CANCELED'))
    </update>
    <!--
      拉起成功后的显性回写：终态（FAILED 等）行不会被 updateStatusIfNotEndState 与状态同步循环覆盖，
      必须在拉起入口主动重置为 RUNNING，清空 end_time（运行时长重新计时）与 error_message（清掉上次失败原因）。
    -->
    <update id="resetForRestore">
        UPDATE t_st_job_instance
        SET job_status    = 'RUNNING',
            end_time      = NULL,
            error_message = ''
        WHERE id = #{id}
    </update>
    <select id="countActiveByJobDefinitionId" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM t_st_job_instance t
        WHERE t.job_define_id = #{jobDefinitionId}
          AND t.workspace_id = #{workspaceId}
          AND t.job_status IN ('SCHEDULED', 'RUNNING')
    </select>
</mapper>
