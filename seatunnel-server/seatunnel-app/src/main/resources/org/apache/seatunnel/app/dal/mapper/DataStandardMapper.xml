<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apache.seatunnel.app.dal.mapper.DataStandardMapper">
  <select id="checkDataStandardCodeUnique" resultType="int">
    SELECT COUNT(*) FROM t_st_data_standard
    WHERE code = #{code} AND workspace_id = #{workspaceId}
    <if test="standardId != null">
      AND id != #{standardId}
    </if>
  </select>
  <select id="checkHasVirtualTableReference" resultType="int">
    SELECT COUNT(*) FROM t_st_virtual_table_standard
    WHERE standard_id = #{standardId} AND workspace_id = #{workspaceId}
  </select>
</mapper>
