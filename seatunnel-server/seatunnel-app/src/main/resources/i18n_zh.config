    enable_upsert_description = "是否启用Upsert写入模式"
    field_ide = "字段命名策略"
    field_ide_description = "字段命名转换策略"
    tablePrefix = "表名前缀"
    tablePrefix_description = "写入的目标表名前缀"
    tableSuffix = "表名后缀"
    tableSuffix_description = "写入的目标表名后缀"
    multi_table_sink_replica = "多表写入副本数"
    multi_table_sink_replica_description = "多表写入时的副本数"
    dialect = "SQL方言"
    dialect_description = "数据库SQL方言，根据数据库类型自动选择"
    table_path = "表路径"
    table_path_description = "表的完整路径"
    where_condition = "过滤条件"
    where_condition_description = "行级过滤条件，必须以 where 开头，例如 where id > 100"
    table_list = "表列表配置"
    table_list_description = "多表读取时的表列表详细配置"
    split_size = "分片大小"
    split_size_description = "表快照的分片大小（行数），捕获的表在读取时会被拆分为多个分片"
