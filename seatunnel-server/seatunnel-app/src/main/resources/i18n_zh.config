    support_upsert_by_insert_only = "仅通过插入实现Upsert"
    support_upsert_by_insert_only_description = "仅通过INSERT语句实现Upsert语义"
    use_copy_statement = "使用Copy语句"
    use_copy_statement_description = "是否使用COPY语句进行批量写入"
    compatible_mode = "兼容模式"
    compatible_mode_description = "数据库兼容模式，如无需特殊兼容可不填"
