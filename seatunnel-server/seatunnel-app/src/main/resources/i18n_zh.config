}

S3File {
    path = "路径"
    path_description = "读取或写入数据的路径，例如: /seatunnel/path1"
    file_format_type = "文件格式"
    bucket = "S3桶地址"
    fs_s3a_endpoint = "S3a Endpoint"
    fs_s3a_endpoint_description = "例如: s3.cn-north-1.amazonaws.com.cn"
    fs_s3a_aws_credentials_provider = "S3 Credentials Provider"
    read_columns = "读取的字段列表"
    read_columns_description = "需要从文件中读取的字段列表，应该是文件中所有字段的子集"
    access_key = "Access Key"
    access_secret = "Access Secret"
    hadoop_s3_properties = "Hadoop S3 Api可选参数"
    hadoop_s3_properties_description = "使用hadoop s3 api访问s3可选的其它参数. 比如: \n{'{'}fs.s3a.buffer.dir = /data/st_test/s3a\nfs.s3a.fast.upload.buffer = disk\n{'}'}"
    delimiter = "文件中的字段分隔符"
    delimiter_description = "文件中使用的字段分隔符, 默认值是 \\001"
    parse_partition_from_path = "是否从子目录中解析分区字段"
    parse_partition_from_path_description = "是否从子目录中解析分区字段"
    date_format = "日期格式化"
    date_format_description = "日期类型的格式化，告诉同步任务该如何将字符串转换成日志，目前支持：yyyy-MM-dd， yyyy.MM.dd， yyyy/MM/dd。 默认值是 yyyy-MM-dd"
    datetime_format = "日期时间格式化"
    datetime_format_description = "Datetime类型格式，用于告诉同步任务如何将字符串转换为Datetime，支持以下格式: yyyy-MM-dd HH:mm:ss yyyy.MM.dd HH:mm:ss yyyy/MM/dd HH:mm:ss yyyyMMddHHmmss. 默认值是 yyyy-MM-dd HH:mm:ss"
    time_format = "时间类型格式化"
    time_format_description = "时间类型格式，用于告诉连接器如何将字符串转换为时间，支持以下格式: HH:mm:ss HH:mm:ss.SSS. 默认值是 HH:mm:ss"
    skip_header_row_number = "跳过文件的前几行"
    skip_header_row_number_description = "跳过前几行，仅用于text和csv文件格式类型。"
    schema = "schema"
}

MySQL-CDC {
    username = "用户名"
    username_description = "连接数据库服务器所使用的用户名。"
    password = "密码"
    base_url = "JDBC连接Url"
    server_time_zone = "数据库服务器会话时区"
    format = "数据输出格式"
    DEFAULT = "默认格式"
    COMPATIBLE_DEBEZIUM_JSON = "兼容Debezium Json格式"
    snapshot_split_size = "历史数据阶段每次读取的行数"
    snapshot_split_size_description = "在历史数据读取阶段，每次Split读取的数据行数。每个表将被拆分为多个Split以进行并行读取"
    snapshot_fetch_size = "JDBC每批拉取行数"
    snapshot_fetch_size_description = "读取表快照时的JDBC每批拉取行数"
    incremental_parallelism = "增量读取阶段并行度"
    incremental_parallelism_description = "增量读取状态下的并行数。现在仅支持配置为1"
    startup_mode = "作业启动模式"
    startup_mode_description = "CDC源的作业启动模式，可选值：initial（先全量再增量）、earliest（最早binlog开始增量）、latest（最新binlog开始增量）、specific（指定binlog位置开始增量）、timestamp（指定时间戳对应的binlog开始增量）"
    INITIAL = "先全量同步所有历史数据，再自动增量同步新增数据"
    EARLIEST = "不同步历史数据，从能找到的最早的binlog开始增量同步"
    LATEST = "不同步历史数据，从能找到的最新的binlog开始增量同步"
    SPECIFIC = "不同步历史数据，从指定的binlog文件和位置开始增量同步"
    TIMESTAMP = "不同步历史数据，从指定的时间查找对应的binlog文件和位置开始增量同步"
    startup_specific_offset_file = "开始同步的log文件名"
    startup_specific_offset_file_description = "配置文件和位置以开始读取"
    startup_specific_offset_pos = "开始同步的log位置"
    startup_specific_offset_pos_description = "配置开始读取的log的位置"
    stop_mode = "作业停止模式"
    stop_mode_description = "CDC源的作业停止模式，可选值：never（持续运行）、latest（最新binlog停止）、specific（指定binlog位置停止）"
    NEVER = "持续运行，不主动停止"
    debezium = "Debezium相关的配置参数"
    debezium_description = "将Debezium的参数传递给DebeziumEmbeddedEngine，该引擎用于从MySQL服务器捕获数据更改。您可以从 https://debezium.io/documentation/reference/1.6/connectors/mysql.html#mysql-connector-properties 获取更多信息. 示例: \n{'{'}\n snapshot.mode = \"never\"\n decimal.handling.mode = \"double\"\n:{'}'}"
    server_id = "MySQL服务器ID"
    server_id_description = "此数据库客户端在MySQL集群中的数字ID或ID范围。语法如'5400'（单个ID）或'5400-5408'（范围）。每个ID必须在MySQL集群中所有正在运行的数据库进程中唯一。默认在6500-2148492146之间随机生成，建议显式设置。"
    connect_timeout_ms = "数据库连接超时时长（毫秒）"
    connect_timeout_ms_description = "在超时之前，连接器尝试连接到数据库服务器后应等待的最长时间"
    connect_max_retries = "数据库连接最大重试次数"
    connect_max_retries_description = "连接器可以重试以建立数据库服务器连接的最大重试次数"
    connection_pool_size = "数据库连接池大小"
    connection_pool_size_description = "数据库连接池大小"
    parallelism = "并行度"
    parallelism_description = "读取历史数据阶段的并行度。它影响读取历史数据的速度。"
    url = "JDBC连接地址"
    url_description = "数据库服务器的JDBC连接URL地址"
    database_names = "数据库名称列表"
    database_names_description = "要监控的数据库名称，多个数据库用逗号分隔"
    table_names = "表名列表"
    table_names_description = "要监控的表名称列表，格式为 数据库.表名，多个表用逗号分隔"
    table_pattern = "表名匹配正则"
    table_pattern_description = "要监控的表名正则匹配模式"
    startup_timestamp = "启动时间戳（毫秒）"
    startup_timestamp_description = "\"timestamp\"启动模式下使用的时间戳值，单位为毫秒"
    stop_specific_offset_file = "停止时的binlog文件名"
    stop_specific_offset_file_description = "\"specific\"停止模式下使用的binlog文件名"
    stop_specific_offset_pos = "停止时的binlog位置"
    stop_specific_offset_pos_description = "\"specific\"停止模式下使用的binlog偏移位置"
    exactly_once = "启用精确一次语义"
    exactly_once_description = "启用精确一次语义，确保数据不重不丢"
    schema_changes_enabled = "启用Schema变更事件发送"
    schema_changes_enabled_description = "启用发送Schema变更事件到下游，默认为false"
    int_type_narrowing = "整数类型收窄"
    int_type_narrowing_description = "是否将整数类型（如TINYINT(1)）收窄为更具体的布尔类型，目前支持MySQL"
    chunk_key_even_distribution_factor_upper_bound = "分片键均匀分布上限因子"
    chunk_key_even_distribution_factor_upper_bound_description = "分片键分布因子上限值。分布因子用于判断表数据是否均匀分布。当数据分布均匀时使用均匀计算优化，不均匀时则触发分片查询。分布因子计算公式为 (MAX(id) - MIN(id) + 1) / rowCount。"
    chunk_key_even_distribution_factor_lower_bound = "分片键均匀分布下限因子"
    chunk_key_even_distribution_factor_lower_bound_description = "分片键分布因子下限值。分布因子用于判断表数据是否均匀分布。分布因子计算公式为 (MAX(id) - MIN(id) + 1) / rowCount。"
    sample_sharding_threshold = "采样分片预估阈值"
    sample_sharding_threshold_description = "触发采样分片策略的预估分片数阈值。当分布因子超出上下限范围且预估分片数超过此阈值时，将使用采样分片策略。默认值为1000个分片。"
    inverse_sampling_rate = "采样率分母"
    inverse_sampling_rate_description = "采样分片策略的采样率倒数。该值代表采样率的分母。例如值为1000表示采样率为1/1000。"
    table_names_config = "表详细配置"
    table_names_config_description = "配置表的详细信息，包括主键和快照拆分列等信息。示例：[{\"table\": \"db1.schema1.table1\", \"primaryKeys\": [\"key1\",\"key2\"], \"snapshotSplitColumn\": \"key2\"}]"
}

